VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Renders the admin shell without signing in, for local UI work only. Ignored unless the
# dev server is running: Vite strips it from production builds. Grants nothing on its own,
# since RLS still requires a real admin JWT for every read of unpublished data and every write.
VITE_ADMIN_DEV_BYPASS=false

# Server-only. Configure these in Vercel, not in client bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SITE_URL=
VITE_SITE_URL=

# Server-only. Pepper dell'HMAC con cui /api/mcp hasha i token del server MCP admin.
# Almeno 32 caratteri casuali: senza, l'endpoint rifiuta ogni richiesta.
MCP_TOKEN_PEPPER=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
AUTH_EMAIL_HOOK_SECRET=
EMAIL_SUPPRESSION_WEBHOOK_SECRET=
OPENAI_API_KEY=
TRANSLATION_OPENAI_MODEL=gpt-5.6-luna
SEO_OPENAI_MODEL=gpt-5.6-luna

BUNQ_API_TOKEN=
BUNQ_USER_ID=
BUNQ_MONETARY_ACCOUNT_ID=
BUNQ_SANDBOX=false
BUNQ_PERMITTED_IPS=
BUNQ_WEBHOOK_SECRET=

# Server-only. Supabase Edge Function secrets for editorial social OAuth.
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_FRONTEND_URL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
