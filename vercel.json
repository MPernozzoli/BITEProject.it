{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/llms?full=1"
    },
    {
      "source": "/sitemap-live.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/pack/((?!.*\\.[^/]+$).*)",
      "destination": "/pack/index.html"
    },
    {
      "source": "/Data/((?!.*\\.[^/]+$).*)",
      "destination": "/Data/index.html"
    },
    {
      "source": "/Crew/((?!.*\\.[^/]+$).*)",
      "destination": "/Crew/index.html"
    },
    {
      "source": "/((?!.*\\.[^/]+$).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(login|signup|complete-profile|bookings|profile|unsubscribe)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/mcp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/mcp/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/newsletter/confirm",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/Crew/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
